{
   "command": "taskwheel",
   "desktop-file-name-suffix": " (nightly)",
   "finish-args": [
      "--share=ipc",
      "--socket=fallback-x11",
      "--socket=wayland"
   ],
   "id": "org.beatrixwashere.taskwheel",
   "modules": [
      {
         "name": "taskwheel",
         "buildsystem": "cmake-ninja",
         "builddir": true,
         "sources": [
            {
               "type": "dir",
               "path": "."
            }
         ]
      }
   ],
   "runtime": "org.kde.Platform",
   "runtime-version": "6.11",
   "sdk": "org.kde.Sdk"
}